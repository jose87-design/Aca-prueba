        "jsCode": "return $input.all().map(({json:x})=>{const errors=[];const segment=['docente','centro','empresa','fpe','territorio','otro'].includes(x.segment)?x.segment:'otro';if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(x.email||'')))errors.push('email');if(!x.request_id)errors.push('request_id');if(x.privacy_notice_accepted!==true)errors.push('privacy_notice');if(String(x.message||'').length>1800)errors.push('message_length');return {json:{request_id:String(x.request_id||'').slice(0,100),valid:errors.length===0,errors,segment,marketing_opt_in:x.marketing_opt_in===true,stored:false,notification_sent:false,mode:'validation_only'}};});"
