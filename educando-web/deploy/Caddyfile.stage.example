# Template only. Add this host to the existing configuration; do not replace it.
# Replace host, path, username and password hash. Validate with installed Caddy.
# Caddy >= 2.8 uses basic_auth; older versions use basicauth.
web-stage.example.invalid {
    basic_auth {
        reviewer REPLACE_WITH_CADDY_PASSWORD_HASH
    }
    root * /opt/chispa/web-stage/current/public
    encode gzip
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
