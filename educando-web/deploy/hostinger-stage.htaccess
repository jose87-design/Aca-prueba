Options -Indexes
# Use only in the isolated staging document root.
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=302]

# Security headers. CSP keeps the preserved Pergamino route compatible with its Google Fonts and Apps Script call.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; form-action 'self' https://script.google.com https://ia.educandoconchispa.com; upgrade-insecure-requests"
</IfModule>

# Do not expose hidden/config/backup material if it is ever copied by mistake.
<FilesMatch "(^\.|\.(?:env|ini|log|sql|bak|old|orig|pem|key|zip|gz)$)">
  Require all denied
</FilesMatch>
